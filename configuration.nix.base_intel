{ config, pkgs, lib, ... }:

{
  imports = [
    ./hardware-configuration.nix
  ];

  # -----------------------------------------------------------
  # Base système
  # -----------------------------------------------------------

  # À adapter à ton installation (ne pas changer au hasard)
  system.stateVersion = "24.11";

  nixpkgs.hostPlatform = "x86_64-linux";
  nixpkgs.config.allowUnfree = true;

  networking.hostName = "nixos-intel";

  # -----------------------------------------------------------
  # Bootloader : GRUB *ou* systemd-boot (jamais les deux)
  # -----------------------------------------------------------

  # Délai du menu de démarrage : 1 seconde
  # (option générique, marche avec GRUB et systemd-boot)
  boot.loader.timeout = 1;

  boot.loader.efi.canTouchEfiVariables = true;

  # --- OPTION 1 : GRUB (activé) ---
  boot.loader.grub = {
    enable = true;
    efiSupport = true;
    device = "nodev";        # UEFI
    splashImage = null;

    # Thème sleek-grub-theme (style bigSur pour matcher WhiteSur)
    # withStyle possibles : "bigSur", "dark", "light", "orange"
    theme = (pkgs.sleek-grub-theme.override {
      withBanner = "NixOS";
      withStyle = "bigSur";
    });
  };

  # --- OPTION 2 : systemd-boot (désactivé) ---
  # Pour basculer : commente le bloc grub ci-dessus
  # et décommente la ligne ci-dessous.
  # boot.loader.systemd-boot.enable = true;

  # Nettoie /tmp au boot
  boot.tmp.cleanOnBoot = true;

  # -----------------------------------------------------------
  # Matériel Intel / portable
  # -----------------------------------------------------------

  hardware.cpu.intel.updateMicrocode = true;
  hardware.enableRedistributableFirmware = true;

  services.thermald.enable = true;
  services.power-profiles-daemon.enable = true;
  services.upower.enable = true;

  hardware.bluetooth.enable = true;
  networking.networkmanager.enable = true;

  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true;
  };

  # -----------------------------------------------------------
  # Locale / clavier / timezone
  # -----------------------------------------------------------

  time.timeZone = "Europe/Paris";
  i18n.defaultLocale = "fr_FR.UTF-8";
  services.xserver.xkb.layout = "fr";
  console.keyMap = "fr";

  # -----------------------------------------------------------
  # GNOME Desktop
  # -----------------------------------------------------------

  services.xserver.enable = true;
  services.xserver.libinput.enable = true;
  services.xserver.displayManager.gdm.enable = true;
  services.xserver.desktopManager.gnome.enable = true;
  services.gvfs.enable = true;

  # -----------------------------------------------------------
  # Utilisateurs
  # -----------------------------------------------------------

  users.users.jerome = {
    isNormalUser = true;
    description = "Jerome";
    extraGroups = [ "wheel" "networkmanager" "audio" "video" ];
  };

  # -----------------------------------------------------------
  # Paquets GNOME + WhiteSur
  # -----------------------------------------------------------

  environment.systemPackages = with pkgs; [
    gnome-tweaks
    whitesur-gtk-theme
    whitesur-icon-theme
    git
    vim
    wget
    curl
  ];

  # -----------------------------------------------------------
  # Activation du thème WhiteSur via dconf
  # -----------------------------------------------------------

  programs.dconf.enable = true;

  # Réglages GNOME par défaut pour le profil "user".
  # Le module dconf génère lui-même /etc/dconf (profil + base compilée),
  # il ne faut DONC PAS passer par environment.etc."dconf/...".
  #
  # Si tu préfères le thème sombre, remplace :
  # gtk-theme = "WhiteSur-Light";
  # par :
  # gtk-theme = "WhiteSur-Dark";
  programs.dconf.profiles.user.databases = [
    {
      settings = {
        "org/gnome/desktop/interface" = {
          gtk-theme = "WhiteSur-Light";
          icon-theme = "WhiteSur";
          color-scheme = "default";
        };
      };
    }
  ];

  # -----------------------------------------------------------
  # Mises à jour automatiques sur unstable
  # -----------------------------------------------------------

  system.autoUpgrade = {
    enable = true;
    channel = "https://nixos.org/channels/nixos-unstable";
    dates = "04:30";
    allowReboot = false;
  };

  # -----------------------------------------------------------
  # Nettoyage / purge / optimisation du store Nix
  # -----------------------------------------------------------

  nix.settings = {
    experimental-features = [ "nix-command" "flakes" ];
    auto-optimise-store = true;
  };

  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 30d";
  };

  nix.optimise = {
    automatic = true;
    dates = [ "05:30" ];
  };

  services.journald.extraConfig = ''
    SystemMaxUse=150M
  '';
}
